# Copy this file to .env and fill in the values.

# MongoDB connection string (Atlas or local). Leave empty in development to
# use the embedded MongoDB, which stores data in .data/db.
MONGO_URI=

# Long random string used to sign session cookies. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

PORT=3000
NODE_ENV=development

# Password given to the demo students created by `npm run seed`.
SEED_PASSWORD=hostel-demo-2026
