{
  "name": "nivasa",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "Hostel roommate matching for college students, scored on sleep, study and room habits.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "nodemonConfig": {
    "ext": "js,json,hbs",
    "ignore": ["public/*", ".data/*", "tests/*"]
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "connect-mongo": "5.1.0",
    "dotenv": "16.4.7",
    "express": "4.22.3",
    "express-handlebars": "7.1.3",
    "express-rate-limit": "7.5.0",
    "express-session": "1.19.0",
    "helmet": "8.0.0",
    "mongoose": "8.24.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "10.1.3",
    "nodemon": "3.1.9"
  }
}
